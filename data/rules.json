 "checklist": {
  "base": [
   "Passport (issued <10 yrs, valid 3+ months after return, 2 blank pages)",
   "UK residence proof (eVisa share code / BRP) valid 3+ months after return",
   "Completed application form + recent photo",
   "Travel insurance, €30,000 cover, whole trip",
   "Return flight booking",
   "Accommodation for every night",
   "Last 3 months bank statements"
  ],
  "ILR": [
   "Proof of ILR (eVisa share code)",
   "Employer letter or payslips"
  ],
  "SkilledWorker": [
   "Employer letter confirming job, salary and approved leave",
   "Last 3 payslips"
  ],
  "Student": [
   "University enrolment letter + term dates",
   "Sponsor letter and sponsor bank statements if funded by family"
  ],
  "Spouse": [
   "Marriage certificate",
   "Partner's passport/ID and, if they fund the trip, their bank statements"
  ],
  "other": [
   "Proof of current UK status valid 3+ months beyond return — check eligibility first"
  ],
  "refusal_causes": [
   "Insufficient or unexplained funds (sudden large deposits)",
   "Purpose/itinerary unclear or inconsistent dates across bookings",
   "Doubt you will return — weak proof of UK status, job or studies"
  ]
 }
